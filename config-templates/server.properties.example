# MY-Town Purpur 26.3 Server Properties Template
# Bind strictly to localhost; Playit plugin tunnels directly inside the JVM.
server-ip=127.0.0.1
server-port=25565

# Allow both official and unofficial clients; protected by MYTownGatekeeper pre-join GUI dialog.
online-mode=false
enforce-secure-profile=false
white-list=false
enforce-whitelist=false

# Anti-reconnaissance: hide online usernames from server list ping scanners.
hide-online-players=true
enable-status=true

# Localhost-only RCON for mc-cmd.ps1 and backup-world.ps1
enable-rcon=true
rcon.port=25575
rcon.password=__RCON_PASSWORD__
broadcast-rcon-to-ops=false

# Casual survival & 3-core performance tuning
gamemode=survival
difficulty=normal
pvp=true
max-players=24
view-distance=10
simulation-distance=7
pause-when-empty-seconds=60
network-compression-threshold=256
spawn-protection=0
motd=MY-Town Private Server
